{
    "name": "ds_generic_delimited",
    "type": "Microsoft.DataFactory/factories/datasets",
    "properties": {
        "linkedServiceName": { "referenceName": "ls_adls_gen2", "type": "LinkedServiceReference" },
        "parameters": {
            "filePath": { "type": "String" }
        },
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileSystem": "landing",
                "folderPath": { "value": "@dataset().filePath", "type": "Expression" }
            },
            "columnDelimiter": ",",
            "firstRowAsHeader": true
        },
        "description": "Single reusable dataset parameterized by filePath -- one dataset serves all 13 sources (path comes from pipeline_control.source_path_pattern / landing_path_pattern), avoiding 13 near-identical dataset definitions."
    }
}

  create view "dbt_warehouse"."marts"."kpi_contact_success_rate__dbt_tmp" as (
    select
    count(*) as live_agent_contacts,
    count(*) filter (
        where exists (select 1 from "dbt_warehouse"."marts"."fct_promise_to_pay" p where p.contact_id = cf.contact_id)
    ) as contacts_resulting_in_ptp,
    contacts_resulting_in_ptp::double / nullif(live_agent_contacts, 0) as contact_success_rate
from "dbt_warehouse"."marts"."fct_contact" cf
join "dbt_warehouse"."marts"."dim_channel" ch on ch.channel_sk = cf.channel_sk
where ch.channel_category = 'Live Agent'
  );

[0m23:33:44.870685 [debug] [Thread-3 (]: SQL status: OK in 0.003 seconds
[0m23:33:44.869454 [debug] [Thread-2 (]: Using duckdb connection "model.loan_delinquency_command_center.kpi_collector_productivity"
[0m23:33:44.869744 [debug] [Thread-4 (]: SQL status: OK in 0.001 seconds
[0m23:33:44.871583 [debug] [Thread-4 (]: Using duckdb connection "model.loan_delinquency_command_center.kpi_recovery_rate"
[0m23:33:44.871862 [debug] [Thread-4 (]: On model.loan_delinquency_command_center.kpi_recovery_rate: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "loan_delinquency_command_center", "target_name": "dev", "node_id": "model.loan_delinquency_command_center.kpi_recovery_rate"} */

  
  create view "dbt_warehouse"."marts"."kpi_recovery_rate__dbt_tmp" as (
    select
    sum(case when pf.payment_type = 'Settlement' then pf.payment_amount else 0 end) as recovered_amount,
    sum(l.origination_amount) as charged_off_original_balance,
    recovered_amount / nullif(charged_off_original_balance, 0) as recovery_rate
from "dbt_warehouse"."marts"."dim_loan" l
left join "dbt_warehouse"."marts"."fct_payment" pf on pf.loan_sk = l.loan_sk
where l.charge_off_flag and l.is_current
  );

[0m23:33:44.870989 [debug] [Thread-3 (]: Using duckdb connection "model.loan_delinquency_command_center.kpi_call_connect_rate"
[0m23:33:44.872660 [debug] [Thread-3 (]: On model.loan_delinquency_command_center.kpi_call_connect_rate: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "loan_delinquency_command_center", "target_name": "dev", "node_id": "model.loan_delinquency_command_center.kpi_call_connect_rate"} */

  
  create view "dbt_warehouse"."marts"."kpi_call_connect_rate__dbt_tmp" as (
    select
    count(*) as live_agent_attempts,
    count(*) filter (where cf.is_rpc_flag) as right_party_contacts,
    right_party_contacts::double / nullif(live_agent_attempts, 0) as call_connect_rate
from "dbt_warehouse"."marts"."fct_contact" cf
join "dbt_warehouse"."marts"."dim_channel" ch on ch.channel_sk = cf.channel_sk
where ch.channel_category = 'Live Agent'
  );

[0m23:33:44.871285 [debug] [Thread-2 (]: On model.loan_delinquency_command_center.kpi_collector_productivity: /* {"app": "dbt", "dbt_version": "1.12.0", "profile_name": "loan_delinquency_command_center", "target_name": "dev", "node_id": "model.loan_delinquency_command_center.kpi_collector_productivity"} */

  
  create view "dbt_warehouse"."marts"."kpi_collector_productivity__dbt_tmp" as (
    select
    col.collector_id, col.collector_name, col.team_name,
    count(distinct cf.contact_id) as contacts_made,
    count(distinct ptp.ptp_id) as ptps_obtained,
    sum(case when ptp.ptp_status = 'Kept' then ptp.amount_paid_against_ptp else 0 end) as kept_dollars_collected
from "dbt_warehouse"."marts"."dim_collector" col
left join "dbt_warehouse"."marts"."fct_contact" cf on cf.collector_sk = col.collector_sk
left join "dbt_warehouse"."marts"."fct_promise_to_pay" ptp on ptp.collector_sk = col.collector_sk
where col.is_current
group by col.collector_id, col.collector_name, col.team_name
  );

